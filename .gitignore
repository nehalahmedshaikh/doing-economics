# data/raw IS committed - 7.9 MB, and it makes the repository work offline and
# outlive its sources. Project 5's upstream (the GCIP site) is already gone; the
# copy here is the only reliable one. Provenance is in data/MANIFEST.toml.
#
# data/processed is derived and always reproducible from data/raw, so it is not.
data/processed/*
!data/processed/.gitkeep

# Quarto
/.quarto/
/docs/
*_files/
*.html
!reference/*.html

# Julia
*.jl.cov
*.jl.*.cov
*.jl.mem
/deps/deps.jl
LocalPreferences.toml

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

**/*.quarto_ipynb
