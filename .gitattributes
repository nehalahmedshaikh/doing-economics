# Normalise to LF in the repository. CI renders on Linux, so committing CRLF would
# make _freeze checksums and diffs depend on which platform last touched a file.
* text=auto eol=lf

*.jl   text eol=lf
*.qmd  text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.scss text eol=lf
*.md   text eol=lf

*.xlsx binary
*.png  binary
*.jpg  binary
*.svg  text eol=lf

# Datasets are byte-exact evidence, not source. `-text` disables end-of-line
# normalisation so the committed bytes are the downloaded bytes and the SHA-256 in
# data/MANIFEST.toml still verifies after a clone. Without this, the rule above
# rewrites CRLF to LF in the CSVs on commit and every clone fails verify_data.jl -
# while the machine that committed them keeps passing.
data/raw/** -text
